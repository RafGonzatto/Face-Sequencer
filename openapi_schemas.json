{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/face-sequencer/schemas.json",
  "$defs": {
    "StandardResponse": {
      "type": "object",
      "required": [
        "success"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "error_type": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle_stage": {
          "type": "string"
        }
      }
    },
    "ErrorResponse": {
      "allOf": [
        {
          "$ref": "#/components/schemas/StandardResponse"
        },
        {
          "type": "object",
          "required": [
            "success",
            "error"
          ],
          "properties": {
            "success": {
              "const": false
            },
            "error": {
              "type": "string"
            },
            "error_type": {
              "type": "string"
            },
            "details": {
              "type": "object"
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lifecycle_stage": {
              "type": "string"
            }
          }
        }
      ]
    },
    "AlignmentToken": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "viseme": {
          "type": "string"
        },
        "start_ms": {
          "type": "number"
        },
        "end_ms": {
          "type": "number"
        },
        "duration_ms": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        }
      }
    },
    "AlignmentResult": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "sample_rate": {
          "type": "integer"
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/AlignmentToken"
          }
        },
        "stats": {
          "type": "object"
        }
      }
    },
    "AlignmentResponse": {
      "allOf": [
        {
          "$ref": "#/components/schemas/StandardResponse"
        },
        {
          "type": "object",
          "properties": {
            "alignment": {
              "$ref": "#/components/schemas/AlignmentResult"
            },
            "sequence": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AlignmentToken"
              }
            },
            "stats": {
              "type": "object"
            },
            "cached": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "AlignmentResponseEnhanced": {
      "allOf": [
        {
          "$ref": "#/components/schemas/AlignmentResponse"
        },
        {
          "type": "object",
          "properties": {
            "frame_states": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "timeline": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "AnalysisResponse": {
      "allOf": [
        {
          "$ref": "#/components/schemas/StandardResponse"
        },
        {
          "type": "object",
          "properties": {
            "analysis": {
              "type": "object"
            },
            "stats": {
              "type": "object"
            }
          }
        }
      ]
    },
    "ModelEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "loaded": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "nullable": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load_time_s": {
          "type": "number",
          "nullable": true
        },
        "last_access": {
          "type": "number"
        },
        "error": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "ModelManagerStats": {
      "type": "object",
      "properties": {
        "max_memory_bytes": {
          "type": "integer"
        },
        "current_memory_bytes": {
          "type": "integer"
        },
        "registered_models": {
          "type": "integer"
        },
        "loaded_models": {
          "type": "integer"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ModelEntry"
          }
        }
      }
    },
    "ExportTask": {
      "type": "object",
      "required": [
        "status",
        "progress"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "progress": {
          "type": "integer"
        },
        "filename": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "error": {
          "type": "string",
          "nullable": true
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ExportStatusResponse": {
      "allOf": [
        {
          "$ref": "#/components/schemas/StandardResponse"
        },
        {
          "type": "object",
          "properties": {
            "task": {
              "$ref": "#/components/schemas/ExportTask"
            }
          }
        }
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "folder_path": {
          "type": "string"
        },
        "fallback_image": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "SequenceFrame": {
      "type": "object",
      "properties": {
        "char": {
          "type": "string"
        },
        "img": {
          "type": "string",
          "nullable": true
        },
        "ms": {
          "type": "integer"
        },
        "audio_start": {
          "type": "number"
        },
        "audio_end": {
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "Marker": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        },
        "time_ms": {
          "type": "number"
        }
      }
    },
    "SequenceUpdateRequest": {
      "type": "object",
      "required": [
        "frame_id",
        "updates"
      ],
      "properties": {
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "updates": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "SequenceReorderRequest": {
      "type": "object",
      "required": [
        "from_index",
        "to_index"
      ],
      "properties": {
        "from_index": {
          "type": "integer",
          "minimum": 0
        },
        "to_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SequenceDeleteRequest": {
      "type": "object",
      "required": [
        "frame_id"
      ],
      "properties": {
        "frame_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SequenceBuildFromAudioRequest": {
      "type": "object",
      "required": [
        "audio_filename",
        "text",
        "alignment_tokens"
      ],
      "properties": {
        "audio_filename": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "alignment_tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "viseme": {
                "type": "string"
              },
              "start_ms": {
                "type": "number"
              },
              "end_ms": {
                "type": "number"
              },
              "duration_ms": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/StandardResponse"
}