{
  "name": "video-subtitle-vue-app",
  "version": "1.0.0",
  "description": "A Vue.js application for video playback with subtitle support.",
  "main": "src/main.ts",
  "scripts": {
    "serve": "vite",
    "type-check": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0",
    "pinia": "^2.1.7",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.50.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "@types/node": "^20.0.0",
    "vue-tsc": "^1.8.0",
    "vitest": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0"
  },
  "keywords": [
    "vue",
    "video",
    "subtitles",
    "player"
  ],
  "author": "Your Name",
  "license": "MIT"
}
